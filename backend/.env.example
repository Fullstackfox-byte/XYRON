PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/xyron

# OpenRouter key — get one free at openrouter.ai
OPENROUTER_API_KEY=your_openrouter_key_here

# Model for PPT generation (needs strong JSON instruction-following)
OPENAI_MODEL=google/gemma-4-31b-it:free

# Model for fast chat replies
FAST_CHAT_MODEL=google/gemma-4-31b-it:free

# Gemini key for cover image generation — get free at aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_key_here
GEMINI_IMAGE_MODEL=gemini-2.5-flash-preview-05-20
